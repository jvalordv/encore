{
  "name": "encore",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Karaoke practice and vocal coaching: pitch, timing, dynamics and style feedback, solo or duet, with three visual skins.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
